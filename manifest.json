{
  "manifest_version": 3,
  "name": "Cute Dating Dinos",
  "version": "1.0",
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dino1.png",
        "dino1walk1.png",
        "dino1walk2.png",
        "dino1rev.png",
        "dino2.png",
        "dino2rev.png"
      ],
      "matches" : ["*://*/*"]
    }
  ]
}